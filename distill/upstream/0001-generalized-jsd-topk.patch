@@ -302,6 +314,107 @@ def distillation_loss(
     return distillation_loss, distillation_metrics
 
 
+def generalized_jsd_terms(
+    teacher_topk_log_probs: torch.Tensor,
+    student_topk_log_probs: torch.Tensor,
+    *,
+    beta: float = 0.5,
+    token_clip: Optional[float] = None,
+) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+    """Generalized Jensen-Shannon divergence on a shared sparse support.
+
+    Both arguments are log-probabilities already renormalized over the same
+    support (the teacher's top-k ids), so the divergence is the truncated
+    analogue of the full-vocabulary one.
+
+    ``beta`` interpolates the two directed divergences: 0 gives forward
+    KL(teacher||student), 1 gives reverse KL(student||teacher), and values in
+    between weight the mixture M = beta*teacher + (1-beta)*student, which is the
+    generalized JSD of Agarwal et al. (arXiv:2306.13649).
+
+    Returns per-token loss, a forward-KL diagnostic on the same support, and the
+    fraction of vocabulary entries whose loss component hit ``token_clip``.
+    """
+    teacher_log_p = teacher_topk_log_probs.detach()
+    student_log_p = student_topk_log_probs
+
+    teacher_p = teacher_log_p.exp()
+    student_p = student_log_p.exp()
+    if beta <= 0.0:
+        token_losses = teacher_p * (teacher_log_p - student_log_p)
+    elif beta >= 1.0:
+        token_losses = student_p * (student_log_p - teacher_log_p)
+    else:
+        mixed_p = beta * teacher_p + (1.0 - beta) * student_p
+        mixed_log_p = torch.log(torch.clamp(mixed_p, min=1e-12))
+        token_losses = beta * teacher_p * (teacher_log_p - mixed_log_p) + (1.0 - beta) * student_p * (
+            student_log_p - mixed_log_p
+        )
+
+    if token_clip is not None:
+        clipped = (token_losses.detach() > token_clip).float()
+        token_losses = token_losses.clamp(max=token_clip)
+    else:
+        clipped = torch.zeros_like(token_losses)
+
+    per_token_loss = token_losses.sum(dim=-1)
+    topk_kl = (teacher_p * (teacher_log_p - student_log_p)).sum(dim=-1)
+    return per_token_loss, topk_kl, clipped.mean(dim=-1)
+
+
+@register_distillation_loss(DistillationLossSettings(names=["generalized_jsd_topk"], use_topk=True))  # type: ignore[arg-type]
+def compute_generalized_jsd_topk(
+    config: ActorConfig,
+    distillation_config: DistillationConfig,
+    model_output: dict,
+    data: TensorDict,
+) -> tuple[torch.Tensor, dict[str, Any]]:
+    """Aggregate the generalized-JSD top-k loss produced by the logits processor.
+
+    Returns:
+    - distillation_losses: (bsz, resp_len)
+    - distillation_metrics: Dictionary of metrics.
+    """
+    distillation_losses = no_padding_2_padding(model_output["distillation_losses"], data)
+    topk_kl = no_padding_2_padding(model_output["student_teacher_kl"], data)
+    student_mass = no_padding_2_padding(model_output["student_mass"], data)
+    teacher_mass = no_padding_2_padding(model_output["teacher_mass"], data)
+    clip_ratio_mat = no_padding_2_padding(model_output["jsd_clip_ratio"], data)
+    if data["response_mask"].is_nested:
+        response_mask_bool = data["response_mask"].bool().to_padded_tensor(False)
+    else:
+        response_mask_bool = data["response_mask"].bool()
+    assert (
+        distillation_losses.shape
+        == topk_kl.shape
+        == student_mass.shape
+        == teacher_mass.shape
+        == clip_ratio_mat.shape
+        == response_mask_bool.shape
+    )
+
+    def _agg(mat):
+        return agg_loss(
+            loss_mat=mat,
+            loss_mask=response_mask_bool,
+            loss_agg_mode=config.loss_agg_mode,
+            **config.global_batch_info,
+        )
+
+    valid_student_mass = student_mass[response_mask_bool]
+    valid_teacher_mass = teacher_mass[response_mask_bool]
+    metrics = {
+        "distillation/generalized_jsd/loss": Metric(AggregationType.MEAN, _agg(distillation_losses).detach()),
+        "distillation/generalized_jsd/student_teacher_kl": Metric(
+            AggregationType.MEAN, _agg(topk_kl.detach()).detach()
+        ),
+        "distillation/generalized_jsd/token_clip_ratio": _agg(clip_ratio_mat).detach().item(),
+        "distillation/student_mass": valid_student_mass.mean().item(),
+        "distillation/teacher_mass": valid_teacher_mass.mean().item(),
+    }
+    return distillation_losses, metrics
+
+
 @register_distillation_loss(DistillationLossSettings(names=["forward_kl_topk"], use_topk=True))  # type: ignore[arg-type]
 def compute_forward_kl_topk(
     config: ActorConfig,
