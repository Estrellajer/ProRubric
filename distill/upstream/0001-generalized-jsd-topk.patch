+"""CPU tests for the generalized-JSD distillation loss."""
+
+import pytest
+import torch
+
+from verl.trainer.distillation.losses import (
+    DISTILLATION_LOSS_REGISTRY,
+    TOPK_KERNEL_BY_LOSS_MODE,
+    generalized_jsd_terms,
+)
+from verl.workers.config import DistillationLossConfig
+
+
+def _log_probs(rows):
+    return torch.log(torch.tensor(rows, dtype=torch.float64))
+
+
+TEACHER = _log_probs([[[0.7, 0.2, 0.1]]])
+STUDENT = _log_probs([[[0.2, 0.3, 0.5]]])
+
+
+def _kl(log_p, log_q):
+    return (log_p.exp() * (log_p - log_q)).sum(dim=-1)
+
+
+def test_beta_zero_is_forward_kl():
+    loss, kl, clipped = generalized_jsd_terms(TEACHER, STUDENT, beta=0.0)
+    torch.testing.assert_close(loss, _kl(TEACHER, STUDENT))
+    torch.testing.assert_close(kl, _kl(TEACHER, STUDENT))
+    assert torch.equal(clipped, torch.zeros_like(clipped))
+
+
+def test_beta_one_is_reverse_kl():
+    loss, _, _ = generalized_jsd_terms(TEACHER, STUDENT, beta=1.0)
+    torch.testing.assert_close(loss, _kl(STUDENT, TEACHER))
+
+
+def test_beta_half_matches_the_closed_form_and_is_symmetric():
+    loss, _, _ = generalized_jsd_terms(TEACHER, STUDENT, beta=0.5)
+    mixed = (0.5 * TEACHER.exp() + 0.5 * STUDENT.exp()).log()
+    expected = 0.5 * _kl(TEACHER, mixed) + 0.5 * _kl(STUDENT, mixed)
+    torch.testing.assert_close(loss, expected)
+    swapped, _, _ = generalized_jsd_terms(STUDENT, TEACHER, beta=0.5)
+    torch.testing.assert_close(loss, swapped)
+
+
+def test_jsd_is_bounded_by_log_two_and_zero_on_identical_distributions():
+    loss, _, _ = generalized_jsd_terms(TEACHER, STUDENT, beta=0.5)
+    assert 0.0 < loss.item() <= torch.log(torch.tensor(2.0)).item()
+    same, _, _ = generalized_jsd_terms(TEACHER, TEACHER.clone(), beta=0.5)
+    torch.testing.assert_close(same, torch.zeros_like(same), atol=1e-12, rtol=0)
+
+
+def test_token_clip_bounds_components_and_reports_the_clipped_fraction():
+    unclipped, _, none_clipped = generalized_jsd_terms(TEACHER, STUDENT, beta=0.0)
+    clip = 0.1
+    clipped_loss, _, ratio = generalized_jsd_terms(TEACHER, STUDENT, beta=0.0, token_clip=clip)
+    assert clipped_loss.item() < unclipped.item()
+    assert clipped_loss.item() <= clip * TEACHER.shape[-1]
+    assert none_clipped.item() == 0.0
+    assert 0.0 < ratio.item() <= 1.0
+
+
+def test_gradients_reach_the_student_only():
+    teacher = TEACHER.clone().requires_grad_(True)
+    student = STUDENT.clone().requires_grad_(True)
+    loss, _, _ = generalized_jsd_terms(teacher, student, beta=0.5)
+    loss.sum().backward()
+    assert student.grad is not None and torch.isfinite(student.grad).all()
+    assert teacher.grad is None, "the teacher term must be detached"
+
+
+def test_the_loss_is_registered_and_routed_to_a_kernel():
+    assert "generalized_jsd_topk" in DISTILLATION_LOSS_REGISTRY
+    assert TOPK_KERNEL_BY_LOSS_MODE["generalized_jsd_topk"] == "compute_generalized_jsd_topk"
+    import verl.trainer.distillation.fsdp.losses as fsdp_losses
+
+    assert hasattr(fsdp_losses, "compute_generalized_jsd_topk")
+
+
+@pytest.mark.parametrize(
+    "field, value",
+    [("jsd_beta", 1.5), ("jsd_beta", float("nan")), ("jsd_token_clip", 0.0), ("kd_temperature", 0.0)],
+)
+def test_config_rejects_out_of_range_settings(field, value):
+    with pytest.raises(ValueError):
+        DistillationLossConfig(loss_mode="generalized_jsd_topk", **{field: value})
+
+
+def test_forward_kl_still_requires_an_untempered_partition():
+    with pytest.raises(ValueError, match="kd_temperature=1.0"):
+        DistillationLossConfig(loss_mode="forward_kl_topk", kd_temperature=2.0)
